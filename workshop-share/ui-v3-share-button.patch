 }
 
+/* 分享到幼师学坊弹层 */
+.share-overlay[hidden], .share-done[hidden], .share-modal [hidden] { display: none !important; }
+.share-overlay { position: fixed; inset: 0; background: rgba(20, 21, 26, 0.42); display: grid; place-items: center; padding: 20px; z-index: 50; overflow: auto; }
+.share-modal { width: min(760px, 100%); max-height: calc(100vh - 40px); overflow: auto; background: var(--surface-strong); border-radius: 24px; border: 1px solid var(--line-strong); padding: 22px; display: grid; gap: 16px; }
+.share-lead { margin: 0; line-height: 1.55; }
+.share-step { border: 1px solid var(--line); border-radius: 18px; padding: 14px; background: var(--surface-soft); display: grid; gap: 10px; }
+.share-step-must { border-color: rgba(245, 158, 11, 0.4); background: linear-gradient(180deg, rgba(245, 158, 11, 0.08), var(--surface-soft)); }
+.share-step-head { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
+.share-no { width: 24px; height: 24px; border-radius: 50%; background: var(--primary); color: #fff; display: grid; place-items: center; font-size: 12px; font-family: "Fira Code", monospace; }
+.share-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
+.share-span { grid-column: 1 / -1; }
+.share-field { display: grid; gap: 4px; font-size: 13px; }
+.share-field > span { color: var(--muted); }
+.share-modal input:not([type="checkbox"]), .share-modal select, .share-modal textarea { font: inherit; padding: 9px 11px; border-radius: 12px; border: 1px solid var(--line-strong); background: #fff; width: 100%; box-sizing: border-box; }
+.share-chips { display: flex; gap: 6px; flex-wrap: wrap; }
+.share-chips .chip { cursor: pointer; border: 1px solid var(--line-strong); background: #fff; }
+.share-chips .chip.on { background: var(--accent-soft); color: var(--accent); border-color: rgba(236, 72, 153, 0.3); }
+.share-files { display: grid; gap: 8px; }
+.share-file { display: grid; grid-template-columns: auto auto 1fr; gap: 10px; align-items: center; font-size: 13px; padding: 8px 10px; border-radius: 12px; background: #fff; border: 1px solid var(--line); }
+.share-file em { font-style: normal; font-size: 12px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.share-changes { display: grid; gap: 8px; }
+.share-hints { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; font-size: 13px; }
+.share-hints .chip { cursor: pointer; }
+.chip-warn { background: rgba(245, 158, 11, 0.14); color: #b45309; }
+.share-note { margin: 0; font-size: 12px; }
+.share-switches { display: grid; gap: 10px; }
+.share-switch { display: grid; grid-template-columns: auto 1fr; gap: 6px 10px; align-items: center; font-size: 13px; }
+.share-switch em { grid-column: 2; font-style: normal; font-size: 12px; }
+.share-foot { display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; font-size: 13px; }
+.share-modal .button[disabled] { opacity: 0.45; cursor: not-allowed; }
+.share-done { display: grid; gap: 10px; }
+.share-done p { margin: 0; }
+.head-actions .button { padding: 8px 14px; }
+.head-actions .button[disabled] { opacity: 0.45; cursor: not-allowed; }
+@media (max-width: 720px) { .share-grid { grid-template-columns: 1fr 1fr; } .share-file { grid-template-columns: auto 1fr; } .share-file em { grid-column: 2; } }
+
 @media (max-width: 1280px) {
