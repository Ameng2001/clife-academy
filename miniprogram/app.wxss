/* 配色与 H5 原型一致：柳绿主色、紫荆强调 */
page { background: #f3f6f4; color: #16302b; font-size: 28rpx; line-height: 1.6; font-family: -apple-system, "PingFang SC", "Hiragino Sans GB", sans-serif; }
.wrap { padding: 24rpx 32rpx 40rpx; }
.panel { background: #fff; border: 1rpx solid #d6e0dc; border-radius: 24rpx; padding: 32rpx; margin-bottom: 24rpx; box-shadow: 0 2rpx 4rpx rgba(22,48,43,.05); }
.h1 { font-size: 44rpx; font-weight: 900; line-height: 1.3; }
.h2 { font-size: 34rpx; font-weight: 900; margin-bottom: 16rpx; }
.h3 { font-size: 30rpx; font-weight: 700; }
.eyebrow { font-size: 22rpx; color: #5b716b; letter-spacing: 2rpx; }
.muted { color: #5b716b; }
.small { font-size: 24rpx; }
.num { font-variant-numeric: tabular-nums; }
.row { display: flex; flex-wrap: wrap; gap: 12rpx; align-items: center; }
.between { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; }
.btn { display: inline-flex; align-items: center; justify-content: center; border-radius: 16rpx; padding: 18rpx 32rpx; font-size: 28rpx; font-weight: 700; line-height: 1.3; margin: 0; }
.btn::after { border: none; }
.btn.primary { background: #b0306f; color: #fff; }
.btn.ghost { background: #e2efea; color: #1f6b5c; }
.btn.line { background: #fff; border: 1rpx solid #d6e0dc; color: #16302b; }
.btn.block { display: flex; width: 100%; }
.btn[disabled] { opacity: .45; }
.pill { display: inline-block; font-size: 22rpx; padding: 4rpx 18rpx; border-radius: 999rpx; font-weight: 500; }
.pill.ok { background: #e3f2e8; color: #2f7d4f; }
.pill.warn { background: #fbefd9; color: #a35f00; }
.pill.idle { background: #eceff0; color: #7b8a86; }
.pill.hot { background: #f7e3ed; color: #b0306f; }
.chip { display: inline-block; border: 1rpx solid #d6e0dc; background: #fff; border-radius: 999rpx; padding: 8rpx 24rpx; font-size: 26rpx; color: #5b716b; margin: 0 12rpx 12rpx 0; }
.chip.on { background: #1f6b5c; border-color: #1f6b5c; color: #fff; font-weight: 700; }
.link { color: #b0306f; font-weight: 700; font-size: 26rpx; }
.band { background: #f7e3ed; color: #b0306f; font-size: 22rpx; padding: 10rpx 32rpx; display: flex; justify-content: space-between; }
.band .reset { text-decoration: underline; }
.stat { flex: 1; }
.stat .v { display: block; font-size: 44rpx; font-weight: 700; color: #1f6b5c; }
.stat .k { font-size: 22rpx; color: #5b716b; }
.sd { display: inline-block; width: 18rpx; height: 18rpx; border-radius: 50%; margin-right: 16rpx; flex: none; margin-top: 14rpx; }
.sd.ok { background: #2f7d4f; } .sd.warn { background: #a35f00; } .sd.idle { background: #7b8a86; }
.probe { display: flex; align-items: flex-start; padding: 16rpx 0; border-top: 1rpx solid #d6e0dc; }
.probe:first-child { border-top: 0; }
.probe .body { flex: 1; min-width: 0; }
.probe .sub { display: block; font-size: 22rpx; color: #5b716b; }
.lesson { background: #fff; border: 1rpx solid #d6e0dc; border-radius: 20rpx; overflow: hidden; margin-bottom: 20rpx; }
.lesson .thumb { height: 180rpx; background: #e2efea; position: relative; display: flex; align-items: center; justify-content: center; color: #1f6b5c; font-size: 48rpx; font-weight: 900; }
.lesson .dur { position: absolute; right: 16rpx; bottom: 12rpx; font-size: 22rpx; background: #fff; padding: 2rpx 12rpx; border-radius: 10rpx; color: #16302b; }
.lesson .lk { position: absolute; left: 16rpx; top: 12rpx; }
.lesson .body { padding: 20rpx 24rpx; }
.tag { display: inline-block; font-size: 22rpx; padding: 2rpx 14rpx; border-radius: 10rpx; background: #f3f6f4; color: #5b716b; margin-right: 10rpx; }
.tag.role { background: #e2efea; color: #1f6b5c; }
.toastbox { position: fixed; left: 50%; top: 160rpx; transform: translateX(-50%); background: #16302b; color: #f3f6f4; padding: 14rpx 32rpx; border-radius: 999rpx; font-size: 26rpx; z-index: 99; max-width: 86%; }
.inp, .ta, .input { width: 100%; box-sizing: border-box; border: 1rpx solid #d6e0dc; border-radius: 16rpx; padding: 16rpx 20rpx; font-size: 28rpx; background: #fff; }
.ta { min-height: 160rpx; }
.file { display: flex; align-items: center; gap: 20rpx; padding: 18rpx 0; border-top: 1rpx solid #d6e0dc; }
.file:first-child { border-top: 0; }
.ext { width: 76rpx; height: 64rpx; border-radius: 14rpx; background: #e2efea; color: #1f6b5c; font-size: 20rpx; display: flex; align-items: center; justify-content: center; flex: none; }
.file .body { flex: 1; min-width: 0; }
.file .sub { display: block; font-size: 22rpx; color: #5b716b; }
